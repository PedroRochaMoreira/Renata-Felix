# A Vercel/Neon preenche esta variável automaticamente ao conectar o banco.
DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Mostra a vitrine de demonstração (peças fictícias, fotos do Unsplash) junto do
# catálogo real. Use apenas antes do primeiro cadastro; em produção deixe vazio.
RF_SEED_CATALOG=""
# E-mail que receberá o acesso administrativo no cadastro. Deixe vazio apenas para o primeiro cadastro administrativo local.
ADMIN_EMAIL=""
# Token de produção ou teste do Mercado Pago.
MERCADO_PAGO_ACCESS_TOKEN=""
# Chave secreta do webhook criada no painel do Mercado Pago. Mantém notificações externas autenticadas.
MERCADO_PAGO_WEBHOOK_SECRET=""
# E-mail transacional (Resend). Sem essas variáveis, a loja continua operando, apenas não envia avisos automáticos.
RESEND_API_KEY=""
EMAIL_FROM="Renata Felix <pedidos@seu-dominio.com>"
# Token criado ao conectar um Vercel Blob. Necessário para anexar fotos em produção.
BLOB_READ_WRITE_TOKEN=""
# Credenciais da conta Melhor Envio para cálculo de frete.
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_ORIGIN_CEP=""
MELHOR_ENVIO_SANDBOX="true"
MELHOR_ENVIO_USER_AGENT="Renata Felix Store (contato@renatafelix.com.br)"
