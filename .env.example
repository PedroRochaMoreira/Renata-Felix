# A Vercel/Neon preenche esta variável automaticamente ao conectar o banco.
# Em desenvolvimento, use a URL de uma branch do Neon — nunca a de produção.
DATABASE_URL=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E-mail que receberá o acesso administrativo no cadastro. Deixe vazio apenas
# para o primeiro cadastro administrativo local.
ADMIN_EMAIL=""

# `true` exibe a vitrine de demonstração (peças fictícias, fotos do Unsplash)
# enquanto a loja ainda não tem peças cadastradas. Em produção deixe vazio.
RF_SEED_CATALOG=""

# Token de produção ou teste do Mercado Pago.
MERCADO_PAGO_ACCESS_TOKEN=""
# Obrigatória em produção: sem ela o webhook recusa todas as notificações de
# pagamento e nenhum pedido é confirmado automaticamente.
MERCADO_PAGO_WEBHOOK_SECRET=""

# Credenciais da conta Melhor Envio para cálculo de frete.
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_ORIGIN_CEP=""
MELHOR_ENVIO_SANDBOX="true"
MELHOR_ENVIO_USER_AGENT="Renata Felix Store (contato@renatafelix.com.br)"

# E-mail transacional (Resend). Sem estas variáveis a loja continua operando,
# apenas não envia avisos automáticos.
RESEND_API_KEY=""
EMAIL_FROM="Renata Felix <pedidos@seu-dominio.com>"

# Token criado ao conectar um Vercel Blob. Necessário para anexar fotos em produção.
BLOB_READ_WRITE_TOKEN=""

# Redis REST (Vercel KV ou Upstash). Sem estas duas o rate limit conta apenas
# por instância e não protege de verdade em ambiente serverless.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
